{
  "name": "agent-benchmark-poc",
  "version": "0.1.0",
  "description": "POC reproducible de benchmark para agentes LLM inspirada en Puesto Siete",
  "type": "commonjs",
  "license": "Apache-2.0",
  "author": "Mauricio Perera",
  "repository": {
    "type": "git",
    "url": "https://github.com/MauricioPerera/agent-benchmark-poc.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.cjs",
    "test:reservations": "node reservations-test.cjs",
    "run:offline": "node run.cjs --mode offline --episodes 20 --seed 1000",
    "run:ollama": "node run.cjs --mode ollama --episodes 5 --seed 1000",
    "run:reservations": "node reservations-run.cjs --mode offline --episodes 5 --seed 30000",
    "compare:reservations": "node compare-reservations.cjs --episodes 1 --cases 1 --repeats 1",
    "analyze:reservations": "node analyze-reservations.cjs --input reservations-results.jsonl",
    "analyze:protocol": "node analyze-protocol.cjs --input results/protocol-report.json",
    "run:protocol": "node run-protocol.cjs --dry-run"
  }
}
